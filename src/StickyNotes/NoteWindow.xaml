<Window x:Class="StickyNotes.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sticky Note"
        Width="260" Height="260"
        MinWidth="160" MinHeight="140"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Caption bar: draggable background, hit-test-visible buttons -->
        <Grid x:Name="CaptionBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="NewNoteButton" Grid.Column="0"
                    Content="+" Width="30" Height="30"
                    FontSize="16" FontWeight="Bold"
                    Background="Transparent" BorderThickness="0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="NewNoteButton_Click"
                    ToolTip="New note" />

            <Button x:Name="MenuButton" Grid.Column="2"
                    Content="&#8942;" Width="30" Height="30"
                    FontSize="14"
                    Background="Transparent" BorderThickness="0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="MenuButton_Click"
                    ToolTip="Note color / delete" />

            <Button x:Name="CloseButton" Grid.Column="3"
                    Content="&#10005;" Width="30" Height="30"
                    FontSize="12"
                    Background="Transparent" BorderThickness="0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseButton_Click"
                    ToolTip="Delete note" />
        </Grid>

        <TextBox x:Name="ContentBox" Grid.Row="1"
                 Background="Transparent" BorderThickness="0"
                 Padding="10,6,10,10"
                 FontSize="14"
                 TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="ContentBox_TextChanged" />
    </Grid>
</Window>
